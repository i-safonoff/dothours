DATABASE_URL=postgresql+psycopg2://dothours:dothours@db:5432/dothours
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173"]
LEADERBOARD_TTL_SECONDS=300
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# realtime fan-out: redis across processes, memory inside one
WS_BACKEND=redis
METRICS_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Off by default -- see docker-compose.mail.yml. Flip to true only once
# something is actually listening at smtp_host:smtp_port; there's no
# check at startup, just a failed send the first time a notification fires.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dothours.app
SMTP_USE_TLS=false
